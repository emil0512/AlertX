{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "AlertX Active Pod Replicas",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment='alertx-deployment'}",
          "legendFormat": "Healthy Replicas"
        }
      ]
    },
    {
      "title": "CPU Utilization per Pod",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container='alertx'}[1m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Memory Usage per Pod (MB)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container='alertx'}) by (pod) / 1024 / 1024",
          "legendFormat": "{{pod}} (MB)"
        }
      ]
    },
    {
      "title": "HTTP Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(haproxy_backend_http_responses_total{route='alertx-route'}[1m]))",
          "legendFormat": "Requests/sec"
        }
      ]
    },
    {
      "title": "HPA Current vs Target Replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler='alertx-hpa'}",
          "legendFormat": "Current Pods"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler='alertx-hpa'}",
          "legendFormat": "Desired Pods"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["alertx", "openshift", "kubernetes", "monitoring"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "AlertX Platform - Production Observability Dashboard",
  "version": 1
}
